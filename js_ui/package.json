{
  "name": "anylink-ui",
  "version": "1.0.0",
  "description": "AnyLink UI - Powered by FuickJS",
  "main": "dist/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node esbuild.js",
    "build:dev": "npm run typecheck && node esbuild.js --dev",
    "watch": "node esbuild.js --watch",
    "dev": "npm run build && node debug_server.js",
    "bundle:pack": "node scripts/bundle-pack.js",
    "bundle:pack:app": "node scripts/bundle-pack.js --copy-app",
    "bundle:pack:demo": "node scripts/bundle-pack.js --copy-demo"
  },
  "dependencies": {
    "@fuickjs-community/visibility_detector": "file:../../fuickjs_community/visibility_detector",
    "fuickjs": "file:../../fuickjs_framework/fuickjs",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "esbuild": "^0.19.0",
    "react-reconciler": "0.29.2",
    "scheduler": "0.23.0",
    "typescript": "^5.2.0"
  },
  "overrides": {
    "@types/react": "^18.2.0",
    "@types/react-reconciler": "^0.28.2"
  }
}